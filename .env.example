# 衣物识别、造型建议、买前问衣橱。不填则退回规则，识别改为手填。
XAI_API_KEY=

# 正式部署时设置。本地留空会在进程内临时生成。
BETTER_AUTH_SECRET=

# 部署后的网站地址。本地不用填。
BETTER_AUTH_URL=

# 托管 Postgres（Neon 或 Vercel Postgres）。本地留空则使用 .data/pglite。
# Vercel 上必填。也可以只填 POSTGRES_URL（Vercel Postgres 集成会注入这个名字）。
DATABASE_URL=
POSTGRES_URL=

# 设为 true，并同时填写下面两项，登录页才会出现 Google / X。
VITE_SOCIAL_LOGIN=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_AUTH_ISSUER=
